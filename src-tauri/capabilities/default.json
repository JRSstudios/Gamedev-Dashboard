{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions: events, window state and native file dialogs. File access goes through audited commands in lib.rs.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:webview:default",
    "core:window:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "window-state:default"
  ]
}
